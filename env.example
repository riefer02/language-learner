# Required: OpenAI API key (server-side only; never commit a real key).
OPENAI_API_KEY=your_key_here

# Flask configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=generate_a_long_random_value

# AI models (optional; defaults shown)
TRANSLATION_MODEL=gpt-5.6-luna
CONVERSATION_MODEL=gpt-5.6-luna
TTS_MODEL=tts-1
TTS_VOICE_1=onyx
TTS_VOICE_2=nova

# Abuse controls (optional; defaults shown)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRANSLATE=10
RATE_LIMIT_CONVERSATION=5
RATE_LIMIT_WINDOW_SECONDS=60
# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false

# Learning loop (optional; defaults shown)
NEW_CARDS_PER_DAY=10
ONBOARDING_ENABLED=true
# Used for the daily new-card budget and streak until per-user timezones land.
LEARNER_TIMEZONE=UTC

# Speech checks (transcript-based evidence, not a pronunciation grade)
SPEECH_SCORING_ENABLED=true
SPEECH_PROVIDER=openai
SPEECH_TRANSCRIBE_MODEL=gpt-4o-transcribe
SPEECH_MAX_BYTES=5242880
SPEECH_ACCEPT_THRESHOLD=0.72
# RATE_LIMIT_SPEECH=20
# Scene answer matching is tolerant of punctuation/spacing and close speech transcripts.
SCENE_MATCH_THRESHOLD=0.78

# PWA push reminders. Generate keys with `flask generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@kiku.example
PUSH_ENABLED=true
REMINDER_WINDOW_MINUTES=15

# Optional stop-gap auth for non-local deployments. Real accounts arrive later.
REQUIRE_AUTH=false
APP_USERNAME=kiku
APP_PASSWORD=

# Production only
# SESSION_COOKIE_SECURE=true
# LOG_PATH=app.log
